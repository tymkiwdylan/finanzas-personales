{
  "extends": "next/core-web-vitals",
  "rules": {
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": ["warn", {
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_",
      "caughtErrorsIgnorePattern": "^_"
    }],
    "react-hooks/exhaustive-deps": "off",
    "prefer-const": "off"
  },
  "ignorePatterns": ["node_modules/", ".next/", "public/"]
}
